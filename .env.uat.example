# Copy to .env.uat (gitignored) and fill in. Used by docker-compose.uat.yml:
#   docker compose -f docker-compose.uat.yml --env-file .env.uat up -d --build

# --- Database (internal to the UAT stack, never published to the host) ---
POSTGRES_USER=policyapp_uat
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=policyissuance_uat

# --- App ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Host port the UAT app is published on.
UAT_PORT=8080
# The exact URL testers open in the browser (used for emailed links).
FRONTEND_URL=http://localhost:8080

# --- First-boot seed (set RUN_SEED=true once on a fresh DB, then back to false) ---
RUN_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-min-12-chars
SEED_ADMIN_FULL_NAME=System Admin

# --- SMTP (optional — without it, emails fail with 503 / links are only logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
