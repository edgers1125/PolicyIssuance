# Copy to backend/.env for local development. Every variable marked REQUIRED
# is checked at boot (src/utils/env.js) — the server refuses to start without it.

# REQUIRED
DATABASE_URL="postgresql://policyapp:policyapp@localhost:5432/policyissuance"
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# REQUIRED — base URL of the frontend, used in invite / password-reset email links.
FRONTEND_URL=http://localhost:5173
PORT=4000

# Super admin created by `npx prisma db seed` — REQUIRED only when seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Admin

# Optional — without SMTP, emails fail with 503 (links are still logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
