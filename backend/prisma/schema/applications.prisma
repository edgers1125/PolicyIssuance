model PolicyApplication {
  id                       String            @id @default(uuid()) @db.Uuid
  insured_type             InsuredType
  application_number       String            @unique @db.VarChar(50)
  customer_id              String?           @db.Uuid
  company_id               String?           @db.Uuid
  company_name_snapshot    String?           @db.VarChar(255)
  agent_id                 String            @db.Uuid
  agent_name_snapshot      String?           @db.VarChar(255)
  product_variant_id       String            @db.Uuid
  coverage_start_at        DateTime
  coverage_end_at          DateTime
  application_date         DateTime          @db.Date
  submission_date          DateTime          @db.Date
  status                   ApplicationStatus
  // Total premium is just the sum of every selected coverage's premium_amount.
  // Doc stamps/VAT/LGT are computed from it at the statutory rates in effect at
  // submission time; misc is a flat amount the agent can enter. The grand total
  // (total_premium + doc_stamps + vat + lgt + misc) is never stored — it's
  // computable from these components, so it's derived wherever it's needed.
  total_premium            Decimal           @db.Decimal(18, 2)
  doc_stamps               Decimal           @db.Decimal(18, 2)
  vat                      Decimal           @db.Decimal(18, 2)
  lgt                      Decimal           @db.Decimal(18, 2)
  misc                     Decimal           @db.Decimal(18, 2)
  // Emailed the moment this application is filed/submitted (create or
  // quotation-submit) — "your application is now under approval, please
  // settle payment" plus the application PDF. Separate from the flag below,
  // which governs a second, different email sent later at approval time.
  send_policy_to_email     Boolean           @default(false)
  // Emailed only once POST /policy-approval/:id/approve actually approves
  // this application — the "your policy has been approved" notice plus the
  // issued Policy's own PDF (isPreview: false). Independent of
  // send_policy_to_email above: an agent can ask for either, both, or
  // neither.
  send_policy_to_email_on_approval Boolean   @default(false)
  payment_method           PaymentMethod
  payment_remittance       PaymentRemittance
  // Only set when payment_remittance is DIRECT_TO_BETHEL — which of Bethel's
  // own authorized payment methods the customer will use.
  bethel_payment_method_id String?           @db.Uuid
  remarks                  String?
  document_folder_name     String?           @db.VarChar(255)
  // Set only when this application was created by submitting a quotation
  // (rather than filed fresh) — @unique so a given quotation can only ever
  // convert into one application, letting the submit route and the
  // quotation edit route both cheaply check "has this already been
  // submitted?" via PolicyQuotation.converted_application.
  source_quotation_id      String?           @unique @db.Uuid
  // Server-derived at POST /, never client-set directly — see
  // ApplicationPolicyType's own comment. Defaults NEW_POLICY at the DB level
  // only so the migration adding it didn't fail on rows already on file;
  // every create path always ends up with an explicit value one way or
  // another (either by omission here, for NEW_POLICY, or set to RENEWAL
  // alongside renewed_policy_id below).
  policy_type              ApplicationPolicyType @default(NEW_POLICY)
  // Only set when policy_type is RENEWAL — which already-issued Policy this
  // application renews (the Client Policies page's "Renew This Policy"
  // action). coverage_start_at is validated at POST / to never be earlier
  // than this policy's own expiry_date.
  renewed_policy_id        String?           @db.Uuid
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt

  customer              Customer?                @relation(fields: [customer_id], references: [id])
  company               Company?                 @relation(fields: [company_id], references: [id])
  agent                 Agent                    @relation(fields: [agent_id], references: [id])
  product_variant       ProductVariant           @relation(fields: [product_variant_id], references: [id])
  bethel_payment_method AuthorizedPaymentMethod? @relation(fields: [bethel_payment_method_id], references: [id])
  source_quotation      PolicyQuotation?         @relation(fields: [source_quotation_id], references: [id])
  renewed_policy         Policy?                 @relation("PolicyRenewals", fields: [renewed_policy_id], references: [id])

  vehicles         PolicyApplicationVehicle[]
  addresses        PolicyApplicationAddress[]
  coverages        ApplicationCoverage[]
  approval_history ApprovalHistory[]
  changes          PolicyApplicationChange[]
  policy           Policy?

  @@index([status])
  @@index([customer_id])
  @@index([company_id])
  @@index([agent_id])
}

model PolicyApplicationVehicle {
  id                    String   @id @default(uuid()) @db.Uuid
  policy_application_id String   @db.Uuid
  vehicle_id            String   @db.Uuid
  created_at            DateTime @default(now())

  policy_application PolicyApplication @relation(fields: [policy_application_id], references: [id])
  vehicle            Vehicle           @relation(fields: [vehicle_id], references: [id])

  application_coverages ApplicationCoverage[]
  changes                PolicyApplicationChange[]

  @@index([policy_application_id])
}

model PolicyApplicationAddress {
  id                    String      @id @default(uuid()) @db.Uuid
  policy_application_id String      @db.Uuid
  address_id            String      @db.Uuid
  role                  AddressRole
  created_at            DateTime    @default(now())

  policy_application PolicyApplication @relation(fields: [policy_application_id], references: [id])
  address            Address           @relation(fields: [address_id], references: [id])

  @@unique([policy_application_id, role])
  @@index([policy_application_id])
}

model ApplicationCoverage {
  id                            String   @id @default(uuid()) @db.Uuid
  application_id                String   @db.Uuid
  coverage_id                   String   @db.Uuid
  // Which vehicle (on a Motor application) this coverage was priced/applied
  // for — null means it applies to the whole policy (every vehicle on the
  // application), with amounts already scaled by vehicle count. Points at the
  // application's own PolicyApplicationVehicle join row rather than Vehicle
  // directly, so this can never reference a vehicle that isn't actually part
  // of this application.
  policy_application_vehicle_id String?  @db.Uuid
  coverage_amount               Decimal  @db.Decimal(18, 2)
  premium_amount                Decimal  @db.Decimal(18, 2)
  // What's actually owed to Bethel for this row — coverage_amount × the
  // agent's net rate (PERCENTAGE/VALUE_PERCENTAGE) or the tier's fixed price
  // (FLAT_TIER). The agent's premium_amount is their own asking price, always
  // >= this; premium_amount - payable_to_bethel is their profit on the row.
  payable_to_bethel             Decimal  @db.Decimal(18, 2)
  // The net rate actually in effect for the agent at submission time — frozen
  // here so historical branch revenue stays accurate even if rates change later.
  // 0 for FLAT_TIER, which has no rate — just a fixed payable_to_bethel price.
  applied_rate                  Decimal  @db.Decimal(10, 6)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt

  application                PolicyApplication         @relation(fields: [application_id], references: [id])
  coverage                   ProductCoverage           @relation(fields: [coverage_id], references: [id])
  policy_application_vehicle PolicyApplicationVehicle? @relation(fields: [policy_application_vehicle_id], references: [id])

  changes PolicyApplicationChange[]

  @@index([application_id])
  @@index([policy_application_vehicle_id])
}

// An approver's audit trail of corrections against one PolicyApplication,
// recorded after submission without ever touching the application row itself
// (see routes/policyApproval.js's POST /:id/changes) — the application stays
// exactly as filed, and this table is what the corrected PDF re-export (and,
// on approval, the issued Policy) reads from on top of it.
//
// change_from/change_to are always computed server-side, never trusted from
// the client — for VEHICLE_* and INSURED_ADDRESS_DETAILS, change_to is also
// written straight onto the underlying Vehicle/Address row (application_vehicle_id
// says which of the application's vehicles, since a Motor application can carry
// more than one) so the correction is already there the next time that same
// vehicle/address is selected on a future application. AddClause/RemoveClause
// instead amend a *copy* of the coverage's clause text scoped to this one
// application (application_coverage_id) — the shared ProductCoverage.clause
// catalog entry is never touched, since that would silently reword every other
// application/quotation using that coverage too.
model PolicyApplicationChange {
  id                       String                @id @default(uuid()) @db.Uuid
  policy_application_id    String                @db.Uuid
  application_vehicle_id   String?               @db.Uuid
  application_coverage_id  String?               @db.Uuid
  change_type              ApplicationChangeType
  change_from              String?               @db.Text
  change_to                String?               @db.Text
  effective_date           DateTime?             @db.Date
  remarks                  String?               @db.Text
  created_by_user_id       String                @db.Uuid
  created_at               DateTime              @default(now())

  policy_application   PolicyApplication         @relation(fields: [policy_application_id], references: [id])
  application_vehicle  PolicyApplicationVehicle? @relation(fields: [application_vehicle_id], references: [id])
  application_coverage ApplicationCoverage?      @relation(fields: [application_coverage_id], references: [id])
  created_by           User                      @relation(fields: [created_by_user_id], references: [id])

  @@index([policy_application_id])
}
