enum UserStatus {
  AWAITING_EMAIL_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum AddressType {
  RESIDENTIAL
  OFFICE
  WAREHOUSE
  BRANCH
  RISK_LOCATION
}

enum InsuredType {
  INDIVIDUAL
  CORPORATE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  FOR_EDIT_MANAGER
  FOR_EDIT_UNDERWRITING
  PENDING_MANAGER_APPROVAL
  PENDING_UNDERWRITING_APPROVAL
  APPROVED
  REJECTED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  LAPSED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED_FOR_EDIT
}

enum CancellationDecision {
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  ONLINE_PAYMENT
}

// Who the customer's payment actually goes to first — straight to Bethel, or
// to the agent, who then remits it on their own agreed credit terms.
enum PaymentRemittance {
  DIRECT_TO_BETHEL
  THROUGH_AGENT
}

// Distinguishes the two addresses an application can carry: the property
// actually being insured (Property class only) vs. the address the policy
// itself is named on (every class).
enum AddressRole {
  RISK
  INSURED
}
