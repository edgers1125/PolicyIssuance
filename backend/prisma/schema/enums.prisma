enum UserStatus {
  AWAITING_EMAIL_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum AddressType {
  RESIDENTIAL
  OFFICE
  WAREHOUSE
  BRANCH
  RISK_LOCATION
}

enum InsuredType {
  INDIVIDUAL
  CORPORATE
}

// Whether an Agent record is one specific person or an agency/company that
// can have several individual employees under it — see Agent.company_id.
// A CORPORATE agent never itself has a company_id (single level, no chains,
// same depth as Customer.company_id -> Company); an INDIVIDUAL agent's own
// company_id is optional and mutable, so an agent can be reassigned into or
// out of a company at any time without touching historical records.
enum AgentType {
  INDIVIDUAL
  CORPORATE
}

// Single-stage: SUBMITTED -> UNDER_REVIEW (set automatically the moment an
// approver opens it — routes/policyApproval.js's GET /:id) -> APPROVED or
// REJECTED, both terminal. The old multi-step DRAFT/FOR_EDIT_*/
// PENDING_*_APPROVAL values were removed — nothing ever walked an
// application through them, any caller with APPROVE_APPLICATION always
// approved directly.
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  LAPSED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED_FOR_EDIT
}

enum CancellationDecision {
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CHECK
  CREDIT_CARD
  BANK_TRANSFER
  ONLINE_PAYMENT
}

// Who the customer's payment actually goes to first — straight to Bethel, or
// to the agent, who then remits it on their own agreed credit terms.
enum PaymentRemittance {
  DIRECT_TO_BETHEL
  THROUGH_AGENT
}

// Distinguishes the two addresses an application can carry: the property
// actually being insured (Property class only) vs. the address the policy
// itself is named on (every class).
enum AddressRole {
  RISK
  INSURED
}

// How a coverage's premium gets computed:
//  - PERCENTAGE: the existing model — agent enters a coverage amount and
//    premium, floored by the standard/net rate (unchanged behavior).
//  - VALUE_PERCENTAGE: fully computed from the insured vehicle's current
//    (depreciated) value against this coverage's value/rate tiers — no
//    agent-entered amount or margin.
//  - FLAT_TIER: the agent picks one of this coverage's fixed
//    coverage-amount/price pairs — also no agent margin.
//  - VEHICLE_SEATS_BASED: the agent picks an insured-amount-per-occupant
//    tier; coverage_amount is the targeted vehicle's own no_of_seats times
//    that amount. The premium floor is an excess-of-value bracket charge
//    against that total: nothing owed up to threshold_amount, and the
//    excess above it is split into exceed_threshold_amount-sized brackets,
//    each charged exceed_threshold_price. The agent can still mark up their
//    own premium_amount above that floor, same margin model as PERCENTAGE.
enum CoveragePricingMode {
  PERCENTAGE
  VALUE_PERCENTAGE
  FLAT_TIER
  VEHICLE_SEATS_BASED
}

// Whether a filed PolicyApplication is a brand-new policy or a renewal of an
// already-issued one — always server-derived (POST /policy-applications),
// never trusted from the client: RENEWAL only when renewed_policy_id was
// actually sent (the "Renew This Policy" flow from the Client Policies
// page), NEW_POLICY for every other entry point — a fresh filing, or a
// quotation submitted via POST /policy-quotations/:id/submit (which never
// sets renewed_policy_id at all).
enum ApplicationPolicyType {
  NEW_POLICY
  RENEWAL
}

// What kind of in-lease task a backlog row represents — see InLeaseBacklog
// (policies.prisma). FOR_UPLOAD is auto-created for every policy at issuance
// (POST /policy-approval/:id/approve); FOR_ENDORSEMENT is auto-created for a
// policy's own endorsement request once it's approved (POST /endorsements/:id/
// approve), linked via InLeaseBacklog.endorsement_request_id.
enum InLeaseTaskType {
  FOR_UPLOAD
  FOR_ENDORSEMENT
}

// What an approver can record against a PolicyApplication after it's been
// submitted, without ever mutating the application row itself — see
// PolicyApplicationChange. VEHICLE_* and INSURED_ADDRESS_DETAILS each also
// drive a permanent write to the underlying Vehicle/Address row (so the
// correction sticks for future selections); the rest are logged only, folded
// back in wherever this application's own PDF is re-rendered and, on
// approval, into the issued Policy.
enum ApplicationChangeType {
  INSURED_FROM_DATE
  INSURED_NAME_DETAILS
  INSURED_ADDRESS_DETAILS
  VEHICLE_MODEL
  VEHICLE_MV_FILE
  VEHICLE_PLATE_NO
  VEHICLE_TYPE
  VEHICLE_MAKE
  VEHICLE_COLOR
  VEHICLE_ENGINE_NO
  VEHICLE_CHASSIS_NO
  ADD_CLAUSE
  REMOVE_CLAUSE
}

// EndorsementRequest's own lifecycle — SUBMITTED (filed by an agent, still
// editable by an approver), then terminal APPROVED/REJECTED, same
// once-decided-never-reopened shape as ApplicationStatus's own
// APPROVED/REJECTED pair.
enum EndorsementStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// Whether an EndorsementRequest is an ordinary correction batch (the default
// — one or more EndorsementChange lines, filed and reviewed the normal way)
// or a policy cancellation, filed from the same Client Policies composer but
// carrying exactly one CANCEL_POLICY change and no others — see
// EndorsementRequest.request_type and routes/endorsements.js's POST /.
enum EndorsementRequestType {
  CORRECTION
  CANCELLATION
}

// What one EndorsementChange line can amend against an already-issued
// Policy. Most values are still the same "corrections only" scope as
// ApplicationChangeType (no financial effect — POLICY_EFFECTIVE_DATE stands
// in for that enum's own INSURED_FROM_DATE, since the thing being shifted
// here is Policy.effective_date/expiry_date; EDIT_CLAUSE is the renamed-from-
// ADD_CLAUSE fine-print-only edit). Three values ARE financial, and are what
// AgentPayableTransactionType.ENDORSEMENT/CANCELLED_POLICY actually get
// created for (see that enum's own note and routes/endorsements.js's
// POST /:id/approve):
//  - ADD_COVERAGE: prices a brand-new PolicyCoverage line through the same
//    lib/coveragePricing.js engine an application/quotation uses, and — once
//    approved — actually creates that PolicyCoverage row (the one
//    EndorsementChangeType that writes a real row rather than only folding
//    at read time) and credits the agent's payable ledger with its margin.
//  - REMOVE_CLAUSE: repurposed from "remove text from a coverage's clause"
//    (that's EDIT_CLAUSE's job now) to "remove this coverage line entirely"
//    — soft-deletes the targeted PolicyCoverage (PolicyCoverage.removed_at)
//    and debits the agent's payable ledger by the margin that coverage had
//    contributed.
//  - CANCEL_POLICY: the sole change on a CANCELLATION-type request (see
//    EndorsementRequestType) — sets Policy.policy_status to CANCELLED and
//    debits the agent's payable ledger with a day-prorated refund of the
//    commission already earned on this policy.
//  - VEHICLE_ESTIMATED_VALUE: corrects one policy vehicle's assessed value,
//    then recomputes the margin (premium minus payable-to-Bethel) of
//    whichever single VALUE_PERCENTAGE PolicyCoverage row is priced off that
//    vehicle and updates it in place — never add/removed, always the same
//    row. Credits/debits the agent's payable ledger with the resulting
//    margin *delta* (not the full new margin), same
//    prorate-unless-told-otherwise treatment ADD_COVERAGE/REMOVE_CLAUSE now
//    get (see routes/endorsements.js's computeProrationFactor and
//    POST /:id/approve's own prorate flag). 400s at filing time if this
//    vehicle has none or more than one such coverage on this policy — see
//    routes/endorsements.js's priceVehicleValueChange.
// See EndorsementChange (endorsements.prisma) for the extra columns
// ADD_COVERAGE/REMOVE_CLAUSE/VEHICLE_ESTIMATED_VALUE need to carry their own
// pricing.
enum EndorsementChangeType {
  POLICY_EFFECTIVE_DATE
  INSURED_NAME_DETAILS
  INSURED_ADDRESS_DETAILS
  VEHICLE_MODEL
  VEHICLE_MV_FILE
  VEHICLE_PLATE_NO
  VEHICLE_TYPE
  VEHICLE_MAKE
  VEHICLE_COLOR
  VEHICLE_ENGINE_NO
  VEHICLE_CHASSIS_NO
  EDIT_CLAUSE
  REMOVE_CLAUSE
  ADD_COVERAGE
  CANCEL_POLICY
  VEHICLE_ESTIMATED_VALUE
}

// What kind of entry sits in an agent's payable ledger — see
// AgentPayableTransaction (agentPayables.prisma). ISSUANCE always credits the
// balance (amount >= 0); PAYMENT always debits it (amount <= 0). ENDORSEMENT
// can now run either direction — positive when an EndorsementChangeType.
// ADD_COVERAGE line is approved (credits the new coverage's own margin),
// negative when a REMOVE_CLAUSE line is approved (debits the removed
// coverage's own margin) — see that enum's own comment; the DB CHECK
// constraint (see the migration that added it, and the one that relaxed it)
// only restricts ENDORSEMENT's sign insofar as it must be nonzero-consistent
// with which of those two lines produced it, not a fixed direction the way
// ISSUANCE/PAYMENT are. CANCELLED_POLICY always debits it (amount <= 0) —
// created only by a CANCEL_POLICY endorsement's approval, as a day-prorated
// refund of whatever commission (ISSUANCE + ENDORSEMENT credits) this policy
// had already earned; see routes/endorsements.js's own proration comment.
// See AgentPayableTransaction's own note on why this is a signed amount on
// one table rather than a separate payments table.
enum AgentPayableTransactionType {
  ISSUANCE
  ENDORSEMENT
  CANCELLED_POLICY
  PAYMENT
}
