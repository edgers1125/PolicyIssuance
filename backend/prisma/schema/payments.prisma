// Payment methods Bethel itself accepts, when payment is remitted directly to
// Bethel rather than collected by the agent first. Managed in Settings.
model AuthorizedPaymentMethod {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now())

  policy_applications PolicyApplication[]
}
