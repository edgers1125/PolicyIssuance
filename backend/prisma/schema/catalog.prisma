model InsuranceClass {
  id          String       @id @default(uuid()) @db.Uuid
  class_name  String       @unique @db.VarChar(100)
  description String?
  status      RecordStatus
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  product_variants ProductVariant[]
}

model ProductVariant {
  id                 String       @id @default(uuid()) @db.Uuid
  insurance_class_id String       @db.Uuid
  variant_code       String       @unique @db.VarChar(50)
  variant_name       String       @db.VarChar(255)
  description        String?
  status             RecordStatus
  // Null until an admin sets it via Settings → Vehicle Rates
  // (routes/catalog.js's PATCH /product-variants/:id) — a Motor variant
  // without one simply omits the policy schedule's Deductible/Authorized
  // Repair Limit line rather than computing off a 0 rate. Multiplies a
  // vehicle's current depreciated value to get its deductible; the
  // authorized repair limit is then just that deductible plus the fixed
  // ₱500 towing amount — see pdf/theme.js's computeDeductibleFigures()/
  // TOWING_AMOUNT (there is no longer a separate repair-limit rate).
  deductible_rate    Decimal?     @db.Decimal(7, 4)
  // The flat "Miscellaneous" charge on every application/quotation filed
  // under this variant — no longer an amount the agent types in per filing
  // (routes/policyApplications.js's/policyQuotations.js's POST / read this
  // directly off the chosen product_variant instead of req.body). Null is
  // treated as ₱0, same "unconfigured means nothing charged" convention as
  // deductible_rate above, rather than blocking issuance.
  misc_fee           Decimal?     @db.Decimal(18, 2)
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  insurance_class     InsuranceClass      @relation(fields: [insurance_class_id], references: [id])
  product_coverages   ProductCoverage[]
  policy_applications PolicyApplication[]
  policy_quotations   PolicyQuotation[]
  policies            Policy[]
  // Every Vehicle currently insured under this variant — see
  // Vehicle.product_variant_id (Motor-only; enforced at the application layer).
  vehicles            Vehicle[]

  @@index([insurance_class_id])
}

model ProductCoverage {
  id                 String              @id @default(uuid()) @db.Uuid
  product_variant_id String              @db.Uuid
  coverage_code      String              @unique @db.VarChar(50)
  coverage_name      String              @db.VarChar(255)
  maximum_coverage   Decimal             @db.Decimal(18, 2)
  clause             String              @db.Text
  status             RecordStatus
  pricing_mode       CoveragePricingMode @default(PERCENTAGE)
  // Whether this coverage's own premium_amount is folded into the filing's
  // Miscellaneous charge instead of its own Premium total — checked at
  // POST /policy-applications/POST /policy-quotations (see
  // lib/coveragePricing.js's resolveCoverageRows, which reads this straight
  // off the coverage row) so the split between total_premium and misc always
  // reflects the catalog's current flagging at filing time. Defaults false
  // at the DB level only so the migration adding it didn't fail on rows
  // already on file; every catalog-write route always sends an explicit value.
  is_misc            Boolean             @default(false)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  product_variant       ProductVariant            @relation(fields: [product_variant_id], references: [id])
  application_coverages ApplicationCoverage[]
  quotation_coverages   QuotationCoverage[]
  policy_coverages      PolicyCoverage[]
  // ADD_COVERAGE endorsement lines proposing to add this catalog coverage to
  // an already-issued policy — see EndorsementChange.product_coverage_id.
  endorsement_changes   EndorsementChange[]
  // Every pricing table (the coverage's own default pricing, and each
  // agent's override of it) hangs off CoverageAllowablePeriod instead of
  // pointing back here directly — that row already carries the coverage_id,
  // so there's no need for pricing rows to duplicate it.
  allowable_periods     CoverageAllowablePeriod[]

  @@index([product_variant_id])
}

// The set of coverage-period lengths (in days) this coverage is actually
// offered for — e.g. 180 and 365. An application's coverage_start_at/
// coverage_end_at is a single pair shared by every coverage on it, so the
// agent picks one period up front and only coverages that list it here are
// selectable; the server re-enforces that at submission time rather than
// trusting the client's filtering. Every pricing table below (both the
// coverage's own default pricing and each agent's override) is keyed off
// this row's id rather than the coverage directly — a coverage can charge a
// different rate/tier table for its 180-day period than its 365-day one, and
// the coverage itself is always reachable from here via `coverage_id`.
model CoverageAllowablePeriod {
  id               String   @id @default(uuid()) @db.Uuid
  coverage_id      String   @db.Uuid
  coverage_in_days Int
  created_at       DateTime @default(now())

  coverage ProductCoverage @relation(fields: [coverage_id], references: [id])

  percentage_pricing           CoveragePercentageBasedPricing?
  value_percentage_tiers       CoverageValuePercentageTier[]
  tier_based_prices            CoverageTierBasedPricing[]
  seats_based_pricing          CoverageSeatsBasedPricing?
  seats_tier_prices            CoverageSeatsTierPricing[]
  agent_netrates               AgentNetrate[]
  agent_value_percentage_tiers AgentValuePercentageTier[]
  agent_flat_tier_prices       AgentFlatTierPricing[]
  agent_seats_based_pricing    AgentSeatsBasedPricing[]
  agent_seats_tier_prices      AgentSeatsTierPricing[]

  @@unique([coverage_id, coverage_in_days])
  @@index([coverage_id])
}

// PERCENTAGE mode's standard/default rate for one coverage at one allowable
// period — pulled out of ProductCoverage itself since a coverage might not be
// PERCENTAGE-priced at all, and keeping it there implied every coverage had
// one. Absent for a VALUE_PERCENTAGE or FLAT_TIER coverage; one row per
// allowable period for a PERCENTAGE one (e.g. a 180-day rate and a separate
// 365-day rate) — the 1:1 with CoverageAllowablePeriod is what the unique
// coverage_allowable_period_id enforces.
model CoveragePercentageBasedPricing {
  id                           String   @id @default(uuid()) @db.Uuid
  coverage_allowable_period_id String   @unique @db.Uuid
  standard_rate                Decimal  @db.Decimal(10, 6)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  allowable_period CoverageAllowablePeriod @relation(fields: [coverage_allowable_period_id], references: [id])
}

// VALUE_PERCENTAGE mode: the rate for a given vehicle is whichever tier has
// the highest min_value that's still <= the vehicle's current (depreciated)
// value — same shape as a tax bracket table, so tiers can be added or removed
// without needing to keep adjacent max values in sync. Scoped per allowable
// period, so the same coverage can have an entirely different tier table for
// each period it's offered at.
model CoverageValuePercentageTier {
  id                           String   @id @default(uuid()) @db.Uuid
  coverage_allowable_period_id String   @db.Uuid
  min_value                    Decimal  @db.Decimal(18, 2)
  rate_percentage              Decimal  @db.Decimal(7, 4)
  created_at                   DateTime @default(now())

  allowable_period CoverageAllowablePeriod @relation(fields: [coverage_allowable_period_id], references: [id])

  @@unique([coverage_allowable_period_id, min_value])
}

// FLAT_TIER mode: the agent picks one of these fixed coverage-amount options
// for the coverage and the matching price is charged — no computation, no
// agent margin. Scoped per allowable period, same as the value-percentage
// tier table above.
model CoverageTierBasedPricing {
  id                           String   @id @default(uuid()) @db.Uuid
  coverage_allowable_period_id String   @db.Uuid
  coverage_amount              Decimal  @db.Decimal(18, 2)
  coverage_price               Decimal  @db.Decimal(18, 2)
  created_at                   DateTime @default(now())

  allowable_period CoverageAllowablePeriod @relation(fields: [coverage_allowable_period_id], references: [id])

  @@unique([coverage_allowable_period_id, coverage_amount])
}

// VEHICLE_SEATS_BASED mode: the agent picks one of this coverage's insured
// -amount-per-occupant tiers (CoverageSeatsTierPricing below) as "Insured
// amount for each occupant" — coverage_amount is then the vehicle's own
// no_of_seats * that amount (e.g. 15 seats * ₱100,000 = ₱1,500,000 insured),
// and the premium floor is (no_of_seats - threshold_seats) * that same
// tier's own rate_per_excess_seat (e.g. a 7-seat threshold on a 15-seater
// picking the ₱100,000/₱90-per-seat tier floors at 8 * ₱90 = ₱720).
// threshold_seats itself is coverage-wide, not per-tier — 1:1 per allowable
// period, same shape as CoveragePercentageBasedPricing, since there's a
// single default (not a tiered value) to replace per period.
model CoverageSeatsBasedPricing {
  id                           String   @id @default(uuid()) @db.Uuid
  coverage_allowable_period_id String   @unique @db.Uuid
  threshold_seats              Int
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  allowable_period CoverageAllowablePeriod @relation(fields: [coverage_allowable_period_id], references: [id])
}

// VEHICLE_SEATS_BASED mode's own tier menu — same shape/role as
// CoverageTierBasedPricing (FLAT_TIER's own menu), just keyed by
// insured_amount_per_occupant instead of a flat coverage_amount, and paired
// with this tier's own rate_per_excess_seat rather than one fixed price.
model CoverageSeatsTierPricing {
  id                           String   @id @default(uuid()) @db.Uuid
  coverage_allowable_period_id String   @db.Uuid
  insured_amount_per_occupant  Decimal  @db.Decimal(18, 2)
  rate_per_excess_seat         Decimal  @db.Decimal(10, 2)
  created_at                   DateTime @default(now())

  allowable_period CoverageAllowablePeriod @relation(fields: [coverage_allowable_period_id], references: [id])

  @@unique([coverage_allowable_period_id, insured_amount_per_occupant])
}
