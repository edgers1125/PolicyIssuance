model Policy {
  id                     String       @id @default(uuid()) @db.Uuid
  policy_number          String       @unique @db.VarChar(50)
  // Entered by an approver at the moment of approval (see
  // routes/policyApproval.js's POST /:id/approve) — optional, since not every
  // policy has one assigned yet at issuance. Printed on the Policy PDF below
  // "Policy No."/"Date Issued:" respectively (see pdf/policyPdf.js).
  coc_number             String?      @db.VarChar(50)
  sa_number              String?      @db.VarChar(50)
  application_id         String       @unique @db.Uuid
  customer_id            String?      @db.Uuid
  customer_name_snapshot String?      @db.VarChar(255)
  company_id             String?      @db.Uuid
  company_name_snapshot  String?      @db.VarChar(255)
  agent_id               String       @db.Uuid
  agent_name_snapshot    String?      @db.VarChar(255)
  // Frozen off Agent.agent_code at issuance — Policy already froze the
  // agent's *name*; the code needs the same treatment so a re-exported PDF's
  // "Agent Code:" line can't drift if the Agent row is ever edited later.
  agent_code_snapshot    String?      @db.VarChar(50)
  product_variant_id     String       @db.Uuid
  // Frozen off ProductVariant/InsuranceClass at issuance — product_variant_id
  // is still a live FK (kept for reporting/joins), but the printed document
  // must keep reading the way the policy actually looked when issued, same
  // reasoning as PolicyCoverage's own *_snapshot fields below.
  class_name_snapshot    String       @db.VarChar(100)
  variant_name_snapshot  String       @db.VarChar(255)
  // Frozen off ProductVariant.deductible_rate — feeds the policy schedule's
  // Section III Deductible/Authorized Repair Limit line (see
  // pdf/theme.js's computeDeductibleFigures()/TOWING_AMOUNT — the repair
  // limit is just this deductible plus the fixed ₱500 towing amount, no
  // separate rate); a later change via Settings → Vehicle Rates must never
  // alter what an already-issued policy's re-exported PDF shows.
  deductible_rate_snapshot Decimal? @db.Decimal(7, 4)
  // Frozen off ProductVariant.minimum_deductible_amount at the same moment
  // as deductible_rate_snapshot above — see that column's own comment and
  // pdf/theme.js's computeDeductibleFigures(), which takes both snapshots
  // together and prints whichever produces the higher deductible.
  minimum_deductible_amount_snapshot Decimal? @db.Decimal(18, 2)
  // Frozen off the source PolicyApplication's own renewed_policy relation at
  // approval time (its own policy_number, if the application was filed as a
  // RENEWAL) — feeds the "Renewing/Replacing:" line printed above the Period
  // of Insurance on the issued policy PDF (see pdf/policyPdf.js). Never a
  // live join back to that other Policy row, same "an issued policy reads
  // exactly as issued, forever" reasoning as every other *_snapshot field
  // here — that other policy's own number can't change anyway (policy_number
  // has no edit path), but this keeps the pattern consistent and avoids an
  // extra join on every read.
  renewed_policy_number_snapshot String? @db.VarChar(50)
  issue_date             DateTime     @db.Date
  effective_date         DateTime     @db.Date
  expiry_date            DateTime     @db.Date
  policy_status          PolicyStatus
  // Carried over from PolicyApplication at issuance (never recomputed from
  // the statutory-rate constants again afterward) — PolicyApplication itself
  // has no equivalent freeze once *its* upstream data changes, but a Policy
  // is the final, immutable stage, so its own charges must never move.
  total_premium          Decimal      @db.Decimal(18, 2)
  doc_stamps             Decimal      @db.Decimal(18, 2)
  vat                    Decimal      @db.Decimal(18, 2)
  lgt                    Decimal      @db.Decimal(18, 2)
  misc                   Decimal      @db.Decimal(18, 2)
  remarks                String?
  // Set once a CANCEL_POLICY endorsement is approved against this policy
  // (routes/endorsements.js's POST /:id/approve) — the cancellation
  // endorsement's own effective_date, i.e. the date this policy actually
  // stopped being in force (not the approval timestamp). Null for every
  // policy that's never been cancelled. policy_status is what every read
  // path actually branches on; this is just the "when" a CANCELLED policy
  // needs alongside it.
  cancelled_at           DateTime?    @db.Date
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  application     PolicyApplication @relation(fields: [application_id], references: [id])
  customer        Customer?         @relation(fields: [customer_id], references: [id])
  company         Company?          @relation(fields: [company_id], references: [id])
  agent           Agent             @relation(fields: [agent_id], references: [id])
  product_variant ProductVariant    @relation(fields: [product_variant_id], references: [id])

  vehicles             PolicyVehicle[]
  addresses            PolicyAddress[]
  coverages            PolicyCoverage[]
  cancellation_history CancellationHistory[]
  // Every PolicyApplication filed as a renewal of this policy (Client
  // Policies page's "Renew This Policy" action, or auto-detected — see
  // lib/policyConflicts.js) — see PolicyApplication.renewed_policy_id.
  renewal_applications PolicyApplication[] @relation("PolicyRenewals")
  // Every PolicyQuotation auto-detected as continuing this policy's vehicle/
  // risk address — see PolicyQuotation.renewed_policy_id.
  renewal_quotations   PolicyQuotation[]   @relation("QuotationRenewals")
  // Replaces the old added_to_inlease/inlease_added_at flat booleans — see
  // InLeaseBacklog below. One row per required in-lease task on this policy
  // (today, just a single FOR_UPLOAD row created at issuance).
  in_lease_backlogs    InLeaseBacklog[]
  // Every endorsement ever filed against this policy, agent-submitted and
  // approver-reviewed — see EndorsementRequest (endorsements.prisma). Never
  // mutates this Policy row itself; only an APPROVED one's own changes are
  // folded back in wherever this policy's detail/PDF is read (see
  // routes/policies.js's applyEndorsementsToPolicyDetail()).
  endorsement_requests EndorsementRequest[]
  // The POLICY_COMMISSION ledger entry credited to the filing agent when this
  // policy was approved — see AgentPayableTransaction (agentPayables.prisma).
  payable_transactions AgentPayableTransaction[]

  @@index([policy_status])
  @@index([customer_id])
  @@index([company_id])
  @@index([agent_id])
  @@index([expiry_date])
}

// One required in-lease task against one Policy — replaces the old flat
// Policy.added_to_inlease/inlease_added_at booleans, which could only ever
// track a single yes/no per policy. A row is created unaccomplished
// (accomplished_by_user_id/accomplished_at both null) and stays that way
// until someone processes it from the In-Lease Backlogs page
// (routes/inLeaseBacklog.js's POST /:id/accomplish) — "undo"
// (POST /:id/undo) clears both back to null. A policy's own in-lease status
// is never stored directly; it's derived by the route from whether every one
// of its rows here has been accomplished (see toInLeaseSummary()).
model InLeaseBacklog {
  id                      String           @id @default(uuid()) @db.Uuid
  policy_id               String           @db.Uuid
  type                    InLeaseTaskType
  // Set only on a FOR_ENDORSEMENT row (null for FOR_UPLOAD) — which
  // EndorsementRequest this task exists for, so the In-Lease Backlogs page's
  // detail dialog knows which endorsement's own changes to render in
  // copyable format. Created by routes/endorsements.js's POST /:id/approve,
  // alongside marking that request APPROVED.
  endorsement_request_id  String?          @db.Uuid
  accomplished_by_user_id String?          @db.Uuid
  accomplished_at         DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  policy              Policy              @relation(fields: [policy_id], references: [id])
  endorsement_request EndorsementRequest? @relation(fields: [endorsement_request_id], references: [id])
  accomplished_by     User?               @relation(fields: [accomplished_by_user_id], references: [id])

  @@index([policy_id])
  @@index([accomplished_by_user_id])
  @@index([endorsement_request_id])
}

model PolicyVehicle {
  id         String   @id @default(uuid()) @db.Uuid
  policy_id  String   @db.Uuid
  vehicle_id String   @db.Uuid
  // Frozen off Vehicle at issuance — vehicle_id is kept as a live FK (so a
  // future correction still lands on the right underlying Vehicle row for
  // ownership/depreciation purposes), but a PolicyApplicationChange's
  // VEHICLE_* corrections write straight onto that shared Vehicle row (by
  // design — see ApplicationChangeType), which would otherwise silently
  // change what an already-issued policy's PDF shows the next time it's
  // re-exported. These columns are what the PDF actually reads instead.
  plate_number_snapshot   String?  @db.VarChar(50)
  mv_file_no_snapshot     String   @db.VarChar(100)
  engine_number_snapshot  String?  @db.VarChar(100)
  chassis_number_snapshot String   @db.VarChar(100)
  make_snapshot           String?  @db.VarChar(100)
  model_snapshot          String?  @db.VarChar(100)
  year_model_snapshot     Int?
  vehicle_type_snapshot   String?  @db.VarChar(50)
  color_snapshot          String?  @db.VarChar(50)
  no_of_seats_snapshot    Int
  created_at DateTime @default(now())

  policy  Policy  @relation(fields: [policy_id], references: [id])
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id])

  // Endorsement lines correcting one of this vehicle's own snapshot fields
  // (VEHICLE_* EndorsementChangeType values) — see EndorsementChange.
  endorsement_changes EndorsementChange[]

  @@index([policy_id])
}

model PolicyAddress {
  id         String      @id @default(uuid()) @db.Uuid
  policy_id  String      @db.Uuid
  address_id String      @db.Uuid
  role       AddressRole
  // Frozen combined display string off Address at issuance (same
  // comma-joined shape formatAddress() in routes/policyApplications.js
  // already produces) — address_id stays a live FK for ownership purposes,
  // but Address rows are always freely editable via PATCH /addresses/:id
  // with no freeze rule, so the printed document needs its own copy.
  formatted_address_snapshot String @db.Text
  created_at DateTime    @default(now())

  policy  Policy  @relation(fields: [policy_id], references: [id])
  address Address @relation(fields: [address_id], references: [id])

  @@unique([policy_id, role])
  @@index([policy_id])
}

model PolicyCoverage {
  id                     String   @id @default(uuid()) @db.Uuid
  policy_id              String   @db.Uuid
  coverage_id            String   @db.Uuid
  // Frozen off ProductCoverage at policy issuance, since the coverage's own
  // code/name/clause can be edited later and this row must keep reading the
  // way the policy actually looked when it was issued.
  coverage_code_snapshot String   @db.VarChar(50)
  coverage_name_snapshot String   @db.VarChar(255)
  clause_snapshot        String   @db.Text
  // Frozen off ProductCoverage.pricing_mode at issuance — drives the policy
  // schedule's Section III vs. Section IVA/IVB/PA/AOG & Others split (see
  // pdf/policyApplicationPdf.js); a later catalog change to the coverage's
  // pricing mode must never reclassify which section an already-issued
  // policy's coverage prints under.
  pricing_mode_snapshot  CoveragePricingMode
  coverage_amount        Decimal  @db.Decimal(18, 2)
  premium_amount         Decimal  @db.Decimal(18, 2)
  // What's actually owed to Bethel for this row and the net rate that
  // produced it — mirrors ApplicationCoverage's own columns of the same
  // name, frozen at issuance off that same row (routes/policyApproval.js's
  // approveApplicationRecord) so an issued policy keeps a durable,
  // "for transparency" record of exactly what the agent's rates were at the
  // moment it was written, even if that agent's own rates are edited later.
  // Also set on a row an ADD_COVERAGE endorsement itself creates, and read
  // by REMOVE_CLAUSE to compute its own AgentPayableTransaction debit
  // without a live re-price. Still nullable — and still null — on any
  // PolicyCoverage row issued before this column started being populated at
  // issuance; routes/endorsements.js falls back to treating premium_amount
  // itself as fully payable to Bethel for such a legacy row (payable_to_bethel
  // unknown => assume 0 margin) rather than blocking removal of it entirely.
  payable_to_bethel      Decimal? @db.Decimal(18, 2)
  applied_rate           Decimal? @db.Decimal(10, 6)
  // Frozen off ProductCoverage.is_misc at the moment this row was created —
  // needed so a Policy's total_premium/misc split can be correctly
  // recomputed after an ADD_COVERAGE/REMOVE_CLAUSE endorsement without a live
  // join back to a catalog value that might have changed since. Defaults
  // false at the DB level only so the migration adding it didn't fail on
  // rows already on file (backfilled from the live ProductCoverage.is_misc
  // in that same migration); every new write always sends an explicit value.
  is_misc_snapshot       Boolean  @default(false)
  // Only ever set on a row created by an ADD_COVERAGE endorsement — which of
  // the policy's own vehicles this coverage was priced against (null = not
  // vehicle-scoped, e.g. Property, or a PERCENTAGE/FLAT_TIER coverage that
  // doesn't need one). A coverage created at issuance never sets this — see
  // GET /policies/:id/renewal-prefill's own note on why an original
  // PolicyCoverage row can't retain a vehicle scope.
  policy_vehicle_id      String?  @db.Uuid
  // Audit pointers only (not Prisma relations Prisma needs to traverse) —
  // which EndorsementRequest created this row via ADD_COVERAGE, or soft-
  // deleted it via REMOVE_CLAUSE. removed_at non-null means this line no
  // longer counts toward the policy's own current coverages/charges (every
  // read filters it out — see routes/policies.js's policyDetailSelect) but
  // is kept on file rather than hard-deleted, same append-only-history
  // reasoning as every other audit trail in this schema.
  added_by_endorsement_id   String?   @db.Uuid
  removed_at                DateTime?
  removed_by_endorsement_id String?   @db.Uuid
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  policy   Policy          @relation(fields: [policy_id], references: [id])
  coverage ProductCoverage @relation(fields: [coverage_id], references: [id])

  // Endorsement lines amending this coverage line's own clause text
  // (EDIT_CLAUSE) or removing it entirely (REMOVE_CLAUSE) — see
  // EndorsementChange.
  endorsement_changes EndorsementChange[]

  @@index([policy_id])
  @@index([removed_at])
}
