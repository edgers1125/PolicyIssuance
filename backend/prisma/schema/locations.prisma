model Address {
  id                String      @id @default(uuid()) @db.Uuid
  address_line_1    String      @db.VarChar(255)
  address_line_2    String?     @db.VarChar(255)
  barangay          String?     @db.VarChar(100)
  city              String?     @db.VarChar(100)
  province          String?     @db.VarChar(100)
  postal_code       String?     @db.VarChar(20)
  country           String?     @db.VarChar(100)
  latitude          Decimal?    @db.Decimal(10, 7)
  longitude         Decimal?    @db.Decimal(10, 7)
  google_place_id   String?     @db.VarChar(255)
  formatted_address String?
  address_type      AddressType
  // Only meaningful for a RISK_LOCATION address on a Property policy —
  // VALUE_PERCENTAGE coverage pricing for Property prices off this the same
  // way it prices off a Vehicle's estimated_value for Motor. Unlike Vehicle,
  // there's no depreciation/freeze rule here — a property's assessed value
  // doesn't automatically decay the way a vehicle's does, so this can be
  // revised directly at any time via PATCH /addresses/:id.
  estimated_value   Decimal?    @db.Decimal(18, 2)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  party_addresses              PartyAddress[]
  policy_application_addresses PolicyApplicationAddress[]
  policy_quotation_addresses   PolicyQuotationAddress[]
  policy_addresses             PolicyAddress[]
}

// One party (a customer OR a company, never both) linked to one address.
// Merges the old CustomerAddress/CompanyAddress join tables — everything
// that used to branch on party type can now do a single query with an OR.
model PartyAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String?  @db.Uuid
  company_id  String?  @db.Uuid
  address_id  String   @db.Uuid
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  customer Customer? @relation(fields: [customer_id], references: [id])
  company  Company?  @relation(fields: [company_id], references: [id])
  address  Address   @relation(fields: [address_id], references: [id])

  @@index([customer_id])
  @@index([company_id])
}

model Vehicle {
  id                      String    @id @default(uuid()) @db.Uuid
  // Unique at the DB level now too, alongside mv_file_no/engine_number/
  // chassis_number below — every route that creates or edits a vehicle's
  // plate_number already pre-checks this case-insensitively (see
  // routes/policyApplications.js's/policyQuotations.js's own plate-uniqueness
  // note and routes/vehicles.js's PATCH /:id), but this is the real
  // constraint backing that, same as the other three identifiers always had.
  // Still nullable — multiple NULLs don't collide under Postgres's own
  // unique-index semantics.
  plate_number            String?   @unique @db.VarChar(50)
  mv_file_no              String    @unique @db.VarChar(100)
  // Nullable — a real-world engine number (this schedule's own "Authentication
  // No." — see pdf's "Scheduled Vehicle table") is often illegible or simply
  // unavailable off a Philippine OR/CR, unlike every other vehicle
  // identifier here, which stayed required (see vehicleInputSchema). Multiple
  // NULLs don't collide under Postgres's own unique-index semantics, so the
  // @unique constraint still holds for every vehicle that does have one.
  engine_number           String?   @unique @db.VarChar(100)
  chassis_number          String    @unique @db.VarChar(100)
  make                    String?   @db.VarChar(100)
  model                   String?   @db.VarChar(100)
  year_model              Int?
  vehicle_type            String?   @db.VarChar(50)
  color                   String?   @db.VarChar(50)
  // Which Motor ProductVariant this vehicle is currently insured under — a
  // real person's car is always a specific Motor sub-product (e.g. "Private
  // Car" vs. "Commercial Vehicle"), never a bare "Motor" class, so this lives
  // on the vehicle itself rather than being picked as its own step on every
  // application/quotation that reuses it. Nullable only because a vehicle
  // could in principle exist with no Motor history yet to derive it from
  // (schemas/policyIntakeShared.js's vehicleInputSchema requires it on every
  // create, so this is never actually null for a vehicle created going
  // forward) — enforced to reference a Motor-class variant at the
  // application layer (routes/policyApplications.js/policyQuotations.js),
  // not a DB constraint, same as this app's other cross-table invariants.
  // Freely editable later (PATCH /vehicles/:id) — e.g. a vehicle insured as
  // "Private Car" one year can be corrected/switched to "Commercial Vehicle"
  // on a later renewal; each already-issued Policy's own variant_name_snapshot
  // still freezes whichever variant actually applied to *that* policy, so
  // this change never rewrites history, only what a *future* filing defaults to.
  product_variant_id      String?   @db.Uuid
  // Required going forward (see schemas/policyIntakeShared.js's
  // vehicleInputSchema) — feeds the policy schedule's "1 DRIVER AND N
  // OCCUPANTS OR PASSENGERS" endorsement line (N = no_of_seats - 1). Defaults
  // existing rows to 5 so the migration adding this column doesn't fail on
  // vehicles already on file; every new/edited vehicle must supply a real value.
  no_of_seats             Int       @default(5)
  estimated_value         Decimal?  @db.Decimal(18, 2)
  // Stamped automatically the first time an estimated_value is ever set on
  // this vehicle — never edited directly, and never moved once set, even if
  // the value itself is later revised.
  initial_assessment_date DateTime? @db.Date
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  product_variant             ProductVariant?             @relation(fields: [product_variant_id], references: [id])
  party_vehicles              PartyVehicle[]
  policy_application_vehicles PolicyApplicationVehicle[]
  policy_quotation_vehicles   PolicyQuotationVehicle[]
  policy_vehicles             PolicyVehicle[]

  @@index([product_variant_id])
}

// One party (a customer OR a company, never both) linked to one vehicle, for
// one ownership period. Merges the old CustomerVehicle/CompanyVehicle join
// tables — everything that used to branch on party type can now do a single
// query with an OR.
model PartyVehicle {
  id                   String    @id @default(uuid()) @db.Uuid
  customer_id          String?   @db.Uuid
  company_id           String?   @db.Uuid
  vehicle_id           String    @db.Uuid
  ownership_start_date DateTime? @db.Date
  ownership_end_date   DateTime? @db.Date
  created_at           DateTime  @default(now())

  customer Customer? @relation(fields: [customer_id], references: [id])
  company  Company?  @relation(fields: [company_id], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicle_id], references: [id])

  @@index([customer_id])
  @@index([company_id])
}
