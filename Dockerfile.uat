# UAT / staging image — one container serving both the API and the built
# React app from the same Express process:
#   - the frontend is built with Vite and its dist/ copied to backend/public,
#     which backend/src/index.js serves statically (and falls back to
#     index.html for client-side routes);
#   - every API route lives under /api;
#   - the entrypoint applies pending Prisma migrations before starting.
#
# Only backend/src, backend/prisma and the frontend's dist are copied into the
# runtime image. backend/scripts (one-off maintenance scripts, including any
# table-wiping ones) and every .env file are deliberately never copied — see
# .dockerignore. backend/src/pdf/assets (the branch head's signature image)
# IS copied, because the PDF builders read it from disk, but it is never
# served over HTTP: Express only serves backend/public.
#
# Build:  docker compose -f docker-compose.uat.yml build
# Run:    docker compose -f docker-compose.uat.yml up -d

# ---- 1. Build the React app -------------------------------------------------
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Same-origin API under /api (see frontend/src/api/client.js) — no
# VITE_API_URL needed, so one image works on any host/port.
RUN npm run build

# ---- 2. Backend dependencies + generated Prisma client ----------------------
FROM node:22-bookworm-slim AS backend-build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
# Dev dependencies are kept on purpose: the `prisma` CLI (a devDependency)
# is what runs `prisma migrate deploy` in the entrypoint.
RUN npm ci
COPY backend/prisma.config.ts ./
COPY backend/prisma ./prisma
RUN npx prisma generate

# ---- 3. Runtime ---------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    PORT=4000
WORKDIR /app/backend

COPY --from=backend-build /app/backend/node_modules ./node_modules
COPY --from=backend-build /app/backend/generated ./generated
COPY backend/package.json backend/prisma.config.ts ./
COPY backend/prisma ./prisma
COPY backend/src ./src
COPY --from=frontend-build /app/frontend/dist ./public

COPY docker/uat-entrypoint.sh /usr/local/bin/uat-entrypoint.sh
# Strip CRLFs in case the script was checked out on Windows without
# .gitattributes applied — a "\r" in the shebang line breaks exec.
RUN sed -i 's/\r$//' /usr/local/bin/uat-entrypoint.sh && chmod +x /usr/local/bin/uat-entrypoint.sh \
    && chown -R node:node /app

USER node
EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/uat-entrypoint.sh"]
CMD ["node", "src/index.js"]
